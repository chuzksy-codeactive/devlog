{
  "ConnectionStrings": {
    "DevLogDb": "Host=localhost;Port=5432;Database=devlog;Username=devlog;Password=devlog_local",
    "DevLogDbRuntime": "Host=localhost;Port=5432;Database=devlog;Username=devlog_app;Password=devlog_app_local"
  },
  "Clerk": {
    "Authority": "https://REPLACE-WITH-YOUR-CLERK-FRONTEND-API-URL",
    "AuthorizedParty": "REPLACE-WITH-THE-ORIGIN-YOU-ARE-TESTING-FROM"
  },
  "Ai": {
    "GenerationProvider": "OpenAI"
  },
  "Anthropic": {
    "ApiKey": "REPLACE-WITH-YOUR-ANTHROPIC-API-KEY-IF-USING-Ai:GenerationProvider=Anthropic",
    "Model": "claude-haiku-4-5",
    "MaxTokens": 2048
  },
  "OpenAi": {
    "ApiKey": "REPLACE-WITH-YOUR-OPENAI-API-KEY",
    "EmbeddingModel": "text-embedding-3-small",
    "GenerationModel": "gpt-4o-mini",
    "MaxTokens": 2048
  },
  "Postmark": {
    "ApiKey": "REPLACE-WITH-YOUR-POSTMARK-SERVER-TOKEN",
    "FromAddress": "REPLACE-WITH-A-VERIFIED-POSTMARK-SENDER-SIGNATURE"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:3000"
  },
  "Cors": {
    "FrontendOrigins": ["http://localhost:3000"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
