<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Just the Vector value type — not the EF Core integration package,
         which stays in DevLog.Infrastructure. Keeps Domain framework-light,
         same principle as everything else in this project. -->
    <!-- 0.3.2 — Pgvector.EntityFrameworkCore 0.3.0 (DevLog.Infrastructure,
         now that the solution targets .NET 10 / EF Core 10) requires
         Pgvector >= 0.3.2. -->
    <PackageReference Include="Pgvector" Version="0.3.2" />
  </ItemGroup>

</Project>
